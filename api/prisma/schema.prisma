generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  clienteid         Int         @id @default(autoincrement())
  tipo              TipoCliente @default(PESSOA_JURIDICA)
  nomeFantasia      String?
  razaoSocial       String?
  cnpj              String?     @unique
  cpf               String?     @unique
  inscricaoEstadual String?
  responsavel       String?
  site              String?
  cep               String?
  endereco          String?
  numero            String?
  complemento       String?
  bairro            String?
  cidade            String?
  estado            String?
  pais              String?     @default("Brasil")
  observacoes       String?
  origemLead        String?
  tags              String?
  statusCliente     String?
  limiteCredito     Decimal?    @db.Decimal(10, 2)
  descontoPadrao    Decimal?    @db.Decimal(10, 2)
  dataNascimento    DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  email1            String?
  email2            String?
  email3            String?
  email4            String?
  nomeEmail1        String?
  nomeEmail2        String?
  nomeEmail3        String?
  nomeEmail4        String?
  telefone1         String?
  telefone2         String?
  telefone3         String?
  telefone4         String?
  nomeTelefone1     String?
  nomeTelefone2     String?
  nomeTelefone3     String?
  nomeTelefone4     String?
  logo              String?
  agendas           Agenda[]
  propostas         Proposta[]
  notasFiscais      NotaFiscal[]
}

model Servico {
  servicoid        Int            @id @default(autoincrement())
  codigo           String?        @unique
  nome             String
  categoria        String?
  descricao        String?
  descricaoInterna String?
  custo            Decimal?       @db.Decimal(10, 2)
  margemLucro      Decimal?       @db.Decimal(10, 2)
  unidade          String?
  tempoExecucao    String?
  garantia         String?
  observacoes      String?
  ativo            Boolean        @default(true)
  destaque         Boolean        @default(false)
  imagem           String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  itens            ItemProposta[]
}

model Proposta {
  propostaid                 Int               @id @default(autoincrement())
  numero                     String            @unique
  titulo                     String
  subtitulo                  String?
  tipoProposta               TipoProposta      @default(SERVICOS)
  descricao                  String?
  escopo                     String?
  observacoes                String?
  observacoesServicos        String?
  observacoesSistema         String?
  observacoesInternas        String?
  status                     StatusProposta    @default(RASCUNHO)
  prioridade                 String?
  subtotal                   Decimal           @db.Decimal(10, 2)
  frete                      Decimal?          @db.Decimal(10, 2)
  formaPagamento             String?
  condicoesPagamento         String?
  validadeDias               Int?
  dataValidade               DateTime?
  dataAprovacao              DateTime?
  dataRecusa                 DateTime?
  motivoRecusa               String?
  responsavel                String?
  origem                     String?
  assinaturaCliente          String?
  aprovadoCliente            Boolean           @default(false)
  enviadoEmail               Boolean           @default(false)
  enviadoWhatsapp            Boolean           @default(false)
  visualizada                Boolean           @default(false)
  clienteId                  Int
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  templatePropostaTemplateid Int?
  vendedorId                 Int?
  pdfUrl                     String?
  agendas                    Agenda[]
  itens                      ItemProposta[]
  cliente                    Cliente           @relation(fields: [clienteId], references: [clienteid])
  templateProposta           TemplateProposta? @relation(fields: [templatePropostaTemplateid], references: [templateid])
  vendedor                   Vendedor?         @relation(fields: [vendedorId], references: [vendedorid])
  notasFiscais                NotaFiscal[]
}

model ItemProposta {
  itempropostaid Int      @id @default(autoincrement())
  codigo         String?
  descricao      String
  detalhes       String?
  unidade        String?
  quantidade     Decimal  @db.Decimal(10, 2)
  valorUnitario  Decimal  @db.Decimal(10, 2)
  desconto       Decimal? @db.Decimal(10, 2)
  acrescimo      Decimal? @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  ordem          Int?
  observacoes    String?
  propostaId     Int
  servicoId      Int?
  createdAt      DateTime @default(now())
  proposta       Proposta @relation(fields: [propostaId], references: [propostaid], onDelete: Cascade)
  servico        Servico? @relation(fields: [servicoId], references: [servicoid])
}

model Agenda {
  agendaid    Int              @id @default(autoincrement())
  titulo      String
  descricao   String?
  tipo        TipoAgenda
  prioridade  PrioridadeAgenda @default(MEDIA)
  local       String?
  endereco    String?
  cidade      String?
  estado      String?
  dataInicio  DateTime
  dataFim     DateTime?
  concluido   Boolean          @default(false)
  status      String?
  cor         String?
  observacoes String?
  clienteId   Int?
  propostaId  Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  cliente     Cliente?         @relation(fields: [clienteId], references: [clienteid])
  proposta    Proposta?        @relation(fields: [propostaId], references: [propostaid])
}

model Usuario {
  usuarioid         Int       @id @default(autoincrement())
  nome              String
  email             String    @unique
  senha             String
  telefone          String?
  cargo             String?
  foto              String?
  codigoRecuperacao String?
  codigoExpiraEm    DateTime?
  ativo             Boolean   @default(true)
  ultimoLogin       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model TemplateProposta {
  templateid        Int        @id @default(autoincrement())
  nome              String
  descricao         String?
  ativo             Boolean    @default(true)
  logo              String?
  corPrimaria       String?
  corSecundaria     String?
  cabecalho         String?
  rodape            String?
  textoApresentacao String?
  textoGarantia     String?
  textoPagamento          String?
  textoObservacao         String?
  textoObservacaoServicos String?
  textoObservacaoSistema  String?
  exibirLogo        Boolean    @default(true)
  exibirEndereco    Boolean    @default(true)
  exibirTelefone    Boolean    @default(true)
  exibirEmail       Boolean    @default(true)
  exibirAssinatura  Boolean    @default(true)
  htmlPersonalizado String?
  cssPersonalizado  String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  propostas         Proposta[]
}

model Vendedor {
  vendedorid Int        @id @default(autoincrement())
  nome       String
  email      String?
  telefone   String?
  ativo      Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  propostas  Proposta[]
}

enum StatusProposta {
  RASCUNHO
  PENDENTE
  APROVADA
  EXECUTANDO
  ESPECIAIS
  FATURADA
  RECUSADA
  CANCELADA
}

enum TipoProposta {
  SERVICOS
  SISTEMA
}

enum TipoAgenda {
  VISITA
  OBRA
  REUNIAO
  EVENTO
  ENTREGA
}

enum PrioridadeAgenda {
  BAIXA
  MEDIA
  ALTA
}

enum TipoCliente {
  PESSOA_FISICA
  PESSOA_JURIDICA
}

model EmpresaFiscal {
  empresafiscalid              Int                  @id @default(autoincrement())
  razaoSocial                  String
  nomeFantasia                 String?
  cnpj                         String               @unique
  inscricaoEstadual            String?
  inscricaoMunicipal           String?
  regimeTributario             Int                  @default(1)
  cnae                         String?
  cep                          String?
  endereco                     String?
  numero                       String?
  complemento                  String?
  bairro                       String?
  cidade                       String?
  estado                       String?
  codigoMunicipioIbge          String?
  telefone                     String?
  email                        String?
  ambiente                     AmbienteFiscal       @default(HOMOLOGACAO)
  provedor                     String               @default("FOCUS_NFE")
  tokenHomologacao             String?
  tokenProducao                String?
  padraoNfse                   PadraoNfse           @default(MUNICIPAL)
  serieNfe                     String?
  serieNfse                    String?
  naturezaOperacaoNfe          String?
  naturezaOperacaoNfse         String?              @default("1")
  regimeEspecialTributacaoNfse String?
  optanteSimplesNacional       Boolean              @default(true)
  incentivadorCultural         Boolean              @default(false)
  itemListaServicoPadrao       String?
  codigoTributarioMunicipal    String?
  aliquotaIssPadrao            Decimal?             @db.Decimal(7, 4)
  cfopDentroEstado             String?
  cfopForaEstado               String?
  ncmPadrao                    String?
  unidadePadrao                String?              @default("UN")
  icmsOrigemPadrao             Int?                 @default(0)
  icmsSituacaoTributariaPadrao String?
  pisSituacaoTributariaPadrao  String?
  cofinsSituacaoTributariaPadrao String?
  informacoesAdicionaisPadrao  String?
  ativo                        Boolean              @default(true)
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  notas                        NotaFiscal[]
}

model NotaFiscal {
  notafiscalid                  Int                 @id @default(autoincrement())
  referencia                    String              @unique
  tipo                          TipoDocumentoFiscal
  status                        StatusNotaFiscal    @default(RASCUNHO)
  empresaFiscalId               Int
  clienteId                     Int
  propostaId                    Int?
  numero                        String?
  serie                         String?
  chave                         String?
  protocolo                     String?
  codigoVerificacao             String?
  dataEmissao                   DateTime?
  dataAutorizacao               DateTime?
  dataCancelamento              DateTime?
  naturezaOperacao              String?
  finalidadeEmissao             Int                 @default(1)
  consumidorFinal               Int                 @default(1)
  presencaComprador             Int                 @default(9)
  modalidadeFrete               Int                 @default(9)
  indicadorIeDestinatario       Int                 @default(9)
  destinatarioNome              String
  destinatarioCnpj              String?
  destinatarioCpf               String?
  destinatarioIe                String?
  destinatarioIm                String?
  destinatarioEmail             String?
  destinatarioTelefone          String?
  destinatarioCep               String?
  destinatarioEndereco          String?
  destinatarioNumero            String?
  destinatarioComplemento       String?
  destinatarioBairro            String?
  destinatarioCidade            String?
  destinatarioEstado            String?
  destinatarioCodigoMunicipio   String?
  destinatarioPais              String?             @default("Brasil")
  valorProdutos                 Decimal             @default(0) @db.Decimal(14, 2)
  valorServicos                 Decimal             @default(0) @db.Decimal(14, 2)
  valorFrete                    Decimal             @default(0) @db.Decimal(14, 2)
  valorSeguro                   Decimal             @default(0) @db.Decimal(14, 2)
  valorDesconto                 Decimal             @default(0) @db.Decimal(14, 2)
  valorOutrasDespesas           Decimal             @default(0) @db.Decimal(14, 2)
  valorTotal                    Decimal             @default(0) @db.Decimal(14, 2)
  itemListaServico              String?
  codigoTributarioMunicipal     String?
  cnaeServico                   String?
  aliquotaIss                   Decimal?            @db.Decimal(7, 4)
  issRetido                     Boolean             @default(false)
  codigoObra                    String?
  art                           String?
  informacoesAdicionais         String?
  payloadExtra                  Json?
  payloadEnviado                Json?
  retornoProvedor               Json?
  mensagemRetorno               String?
  caminhoXml                    String?
  caminhoPdf                    String?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  empresaFiscal                 EmpresaFiscal       @relation(fields: [empresaFiscalId], references: [empresafiscalid])
  cliente                       Cliente             @relation(fields: [clienteId], references: [clienteid])
  proposta                      Proposta?           @relation(fields: [propostaId], references: [propostaid])
  itens                         ItemNotaFiscal[]
  eventos                       EventoNotaFiscal[]

  @@index([empresaFiscalId])
  @@index([clienteId])
  @@index([propostaId])
  @@index([status])
  @@index([tipo])
  @@index([createdAt])
}

model ItemNotaFiscal {
  itemnotafiscalid              Int       @id @default(autoincrement())
  notaFiscalId                  Int
  codigo                        String?
  descricao                     String
  ncm                           String?
  cest                          String?
  cfop                          String?
  unidade                       String    @default("UN")
  quantidade                    Decimal   @db.Decimal(14, 4)
  valorUnitario                 Decimal   @db.Decimal(14, 6)
  valorBruto                    Decimal   @db.Decimal(14, 2)
  valorDesconto                 Decimal   @default(0) @db.Decimal(14, 2)
  icmsOrigem                    Int?      @default(0)
  icmsSituacaoTributaria        String?
  icmsModalidadeBaseCalculo     Int?
  icmsBaseCalculo               Decimal?  @db.Decimal(14, 2)
  icmsAliquota                  Decimal?  @db.Decimal(7, 4)
  icmsValor                     Decimal?  @db.Decimal(14, 2)
  pisSituacaoTributaria         String?
  pisBaseCalculo                Decimal?  @db.Decimal(14, 2)
  pisAliquota                   Decimal?  @db.Decimal(7, 4)
  pisValor                      Decimal?  @db.Decimal(14, 2)
  cofinsSituacaoTributaria      String?
  cofinsBaseCalculo             Decimal?  @db.Decimal(14, 2)
  cofinsAliquota                Decimal?  @db.Decimal(7, 4)
  cofinsValor                   Decimal?  @db.Decimal(14, 2)
  informacoesAdicionais         String?
  payloadExtra                  Json?
  createdAt                     DateTime  @default(now())
  notaFiscal                    NotaFiscal @relation(fields: [notaFiscalId], references: [notafiscalid], onDelete: Cascade)

  @@index([notaFiscalId])
}

model EventoNotaFiscal {
  eventonotafiscalid Int        @id @default(autoincrement())
  notaFiscalId       Int
  tipo               String
  status             String?
  descricao          String?
  protocolo          String?
  retorno             Json?
  createdAt          DateTime   @default(now())
  notaFiscal         NotaFiscal @relation(fields: [notaFiscalId], references: [notafiscalid], onDelete: Cascade)

  @@index([notaFiscalId])
}

enum AmbienteFiscal {
  HOMOLOGACAO
  PRODUCAO
}

enum PadraoNfse {
  MUNICIPAL
  NACIONAL
}

enum TipoDocumentoFiscal {
  NFE
  NFSE
}

enum StatusNotaFiscal {
  RASCUNHO
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
  ERRO
}

