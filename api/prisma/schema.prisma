generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  clienteid         Int         @id @default(autoincrement())
  tipo              TipoCliente @default(PESSOA_JURIDICA)
  nomeFantasia      String?
  razaoSocial       String?
  cnpj              String?     @unique
  cpf               String?     @unique
  inscricaoEstadual String?
  responsavel       String?
  site              String?
  cep               String?
  endereco          String?
  numero            String?
  complemento       String?
  bairro            String?
  cidade            String?
  estado            String?
  pais              String?     @default("Brasil")
  observacoes       String?
  origemLead        String?
  tags              String?
  statusCliente     String?
  limiteCredito     Decimal?    @db.Decimal(10, 2)
  descontoPadrao    Decimal?    @db.Decimal(10, 2)
  dataNascimento    DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  email1            String?
  email2            String?
  email3            String?
  email4            String?
  nomeEmail1        String?
  nomeEmail2        String?
  nomeEmail3        String?
  nomeEmail4        String?
  telefone1         String?
  telefone2         String?
  telefone3         String?
  telefone4         String?
  nomeTelefone1     String?
  nomeTelefone2     String?
  nomeTelefone3     String?
  nomeTelefone4     String?
  logo              String?
  agendas           Agenda[]
  propostas         Proposta[]
}

model Servico {
  servicoid        Int            @id @default(autoincrement())
  codigo           String?        @unique
  nome             String
  categoria        String?
  descricao        String?
  descricaoInterna String?
  custo            Decimal?       @db.Decimal(10, 2)
  margemLucro      Decimal?       @db.Decimal(10, 2)
  unidade          String?
  tempoExecucao    String?
  garantia         String?
  observacoes      String?
  ativo            Boolean        @default(true)
  destaque         Boolean        @default(false)
  imagem           String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  itens            ItemProposta[]
}

model Proposta {
  propostaid                 Int               @id @default(autoincrement())
  numero                     String            @unique
  titulo                     String
  subtitulo                  String?
  tipoProposta               TipoProposta      @default(SERVICOS)
  descricao                  String?
  escopo                     String?
  observacoes                String?
  observacoesServicos        String?
  observacoesSistema         String?
  observacoesInternas        String?
  status                     StatusProposta    @default(RASCUNHO)
  prioridade                 String?
  subtotal                   Decimal           @db.Decimal(10, 2)
  frete                      Decimal?          @db.Decimal(10, 2)
  formaPagamento             String?
  condicoesPagamento         String?
  validadeDias               Int?
  dataValidade               DateTime?
  dataAprovacao              DateTime?
  dataRecusa                 DateTime?
  motivoRecusa               String?
  responsavel                String?
  origem                     String?
  assinaturaCliente          String?
  aprovadoCliente            Boolean           @default(false)
  enviadoEmail               Boolean           @default(false)
  enviadoWhatsapp            Boolean           @default(false)
  visualizada                Boolean           @default(false)
  clienteId                  Int
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  templatePropostaTemplateid Int?
  vendedorId                 Int?
  pdfUrl                     String?
  agendas                    Agenda[]
  itens                      ItemProposta[]
  cliente                    Cliente           @relation(fields: [clienteId], references: [clienteid])
  templateProposta           TemplateProposta? @relation(fields: [templatePropostaTemplateid], references: [templateid])
  vendedor                   Vendedor?         @relation(fields: [vendedorId], references: [vendedorid])
}

model ItemProposta {
  itempropostaid Int      @id @default(autoincrement())
  codigo         String?
  descricao      String
  detalhes       String?
  unidade        String?
  quantidade     Decimal  @db.Decimal(10, 2)
  valorUnitario  Decimal  @db.Decimal(10, 2)
  desconto       Decimal? @db.Decimal(10, 2)
  acrescimo      Decimal? @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  ordem          Int?
  observacoes    String?
  propostaId     Int
  servicoId      Int?
  createdAt      DateTime @default(now())
  proposta       Proposta @relation(fields: [propostaId], references: [propostaid], onDelete: Cascade)
  servico        Servico? @relation(fields: [servicoId], references: [servicoid])
}

model Agenda {
  agendaid    Int              @id @default(autoincrement())
  titulo      String
  descricao   String?
  tipo        TipoAgenda
  prioridade  PrioridadeAgenda @default(MEDIA)
  local       String?
  endereco    String?
  cidade      String?
  estado      String?
  dataInicio  DateTime
  dataFim     DateTime?
  concluido   Boolean          @default(false)
  status      String?
  cor         String?
  observacoes String?
  clienteId   Int?
  propostaId  Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  cliente     Cliente?         @relation(fields: [clienteId], references: [clienteid])
  proposta    Proposta?        @relation(fields: [propostaId], references: [propostaid])
}

model Usuario {
  usuarioid         Int       @id @default(autoincrement())
  nome              String
  email             String    @unique
  senha             String
  telefone          String?
  cargo             String?
  foto              String?
  codigoRecuperacao String?
  codigoExpiraEm    DateTime?
  ativo             Boolean   @default(true)
  ultimoLogin       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model TemplateProposta {
  templateid        Int        @id @default(autoincrement())
  nome              String
  descricao         String?
  ativo             Boolean    @default(true)
  logo              String?
  corPrimaria       String?
  corSecundaria     String?
  cabecalho         String?
  rodape            String?
  textoApresentacao String?
  textoGarantia     String?
  textoPagamento          String?
  textoObservacao         String?
  textoObservacaoServicos String?
  textoObservacaoSistema  String?
  exibirLogo        Boolean    @default(true)
  exibirEndereco    Boolean    @default(true)
  exibirTelefone    Boolean    @default(true)
  exibirEmail       Boolean    @default(true)
  exibirAssinatura  Boolean    @default(true)
  htmlPersonalizado String?
  cssPersonalizado  String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  propostas         Proposta[]
}

model Vendedor {
  vendedorid Int        @id @default(autoincrement())
  nome       String
  email      String?
  telefone   String?
  ativo      Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  propostas  Proposta[]
}

enum StatusProposta {
  RASCUNHO
  PENDENTE
  APROVADA
  EXECUTANDO
  ESPECIAIS
  FATURADA
  RECUSADA
  CANCELADA
}

enum TipoProposta {
  SERVICOS
  SISTEMA
}

enum TipoAgenda {
  VISITA
  OBRA
  REUNIAO
  EVENTO
  ENTREGA
}

enum PrioridadeAgenda {
  BAIXA
  MEDIA
  ALTA
}

enum TipoCliente {
  PESSOA_FISICA
  PESSOA_JURIDICA
}
