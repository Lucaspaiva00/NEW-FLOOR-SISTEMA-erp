    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-forge": "^1.4.0",
    "nodemailer": "^8.0.11",
    "puppeteer": "^24.10.2",
    "xml-crypto": "6.4.0",
    "@xmldom/xmldom": "0.9.12",
    "libxml2-wasm": "0.7.2",
    "fflate": "0.8.2"
  },
