    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.10",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^7.0.12",
    "nodemon": "^3.1.14",
    "prisma": "^6.14.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
